[Unit]
Description=Gridlock Backend (FastAPI)
After=network.target

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/opt/gridlock/backend
EnvironmentFile=/opt/gridlock/backend/.env
ExecStart=/opt/gridlock/backend/venv/bin/uvicorn app.main:app --host 127.0.0.1 --port 8000
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
